#!/bin/sh
# Opt-in local hook: git config core.hooksPath .githooks
# Blocks a commit that stages a likely secret. Prints file:line only, never the value. Gitleaks is preferred when installed.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner || exit 1
fi
node scripts/dev/secret-scan.js --staged || exit 1
