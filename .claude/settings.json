{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(./backend/**)",
      "Read(./frontend/**)",
      "Read(./docs/**)",
      "Read(./scripts/**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git branch*)",
      "Bash(node --test .claude/hooks/guard.test.js)",
      "Bash(node scripts/dev/secret-scan.js*)",
      "Bash(node --test scripts/dev/secret-scan.test.js)",
      "Bash(npm test)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx eslint*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(docker compose*)",
      "Bash(docker exec*)",
      "Bash(node scripts/e2e/stack.js*)",
      "Bash(npm install*)",
      "Bash(npm run build*)",
      "Bash(./mvnw*)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Edit(./backend/src/main/resources/db/migration/**)",
      "Write(./backend/src/main/resources/db/migration/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./backups/**)",
      "Read(./**/*.dump)",
      "Read(./**/*.bak)",
      "Read(./**/*.mdf)",
      "Read(./**/*.ldf)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(* --no-verify*)",
      "Bash(* --no-gpg-sign*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(docker compose down -v*)",
      "Bash(docker volume rm*)",
      "Bash(docker system prune*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.js\""
          }
        ]
      }
    ]
  }
}
