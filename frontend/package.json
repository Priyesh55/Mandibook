{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "node --test src/lib/*.test.ts",
    "test:e2e": "npm run build:e2e && playwright test",
    "build:e2e": "node -e \"require('child_process').execSync('npx next build',{stdio:'inherit',env:{...process.env,NEXT_DIST_DIR:process.env.NEXT_DIST_DIR||'.next-e2e'}})\"",
    "start:e2e": "next start -p 3100 -H 127.0.0.1"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5"
  }
}
