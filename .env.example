# Copy to .env.local (git-ignored) and fill in locally. NEVER commit real values.
# Load in bash with:  set -a; source .env.local; set +a
# Start with the explicit development profile (-Dspring-boot.run.profiles=demo or dev). Without dev/demo the application is
# production-like and refuses to start unless every variable below is set and safe (docs/RUNNING.md).
#
# RUNTIME connection (the web application): the restricted role mandi_app
DB_USER=mandi_app
DB_PASSWORD=<generated locally: openssl rand -hex 16>
# MIGRATION connection (Flyway only): the schema owner of the local container
MIGRATION_DB_USER=mandi
MIGRATION_DB_PASSWORD=<the dev container owner password from docker-compose.yml>
# Used only by scripts/db/setup-runtime-role.sh (same value as DB_PASSWORD)
MANDI_APP_DB_PASSWORD=<same as DB_PASSWORD>
# Refuse to start if the runtime role is privileged
MANDI_REQUIRE_RESTRICTED_DB_ROLE=true
# AUTHENTICATION (required outside the dev/demo profiles; the dev profile has harmless defaults)
# Secret key for the keyed hashes of emails and addresses in the security log and login throttle, at least 32 characters:
MANDI_SECURITY_HMAC_KEY=<generated locally: openssl rand -hex 32>
# Public origin(s) of the web application, comma separated (the cross-site request check compares the browser's Origin header):
MANDI_ALLOWED_ORIGINS=https://<public address of the web application>
# Public address of the web application, used in invitation links (empty = invitations cannot be created):
MANDI_PUBLIC_BASE_URL=http://localhost:3000
